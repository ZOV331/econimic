<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Mono" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#07080C</item>
        <item name="android:colorPrimaryDark">#07080C</item>
        <item name="android:colorAccent">#4F80FF</item>
        <item name="android:colorControlActivated">#4F80FF</item>
        <item name="android:colorControlHighlight">#334F80FF</item>
        <item name="android:statusBarColor">#07080C</item>
        <item name="android:navigationBarColor">#10131B</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:alertDialogTheme">@style/MonoDialog</item>
    </style>

    <style name="MonoDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#4F80FF</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>
</resources>
